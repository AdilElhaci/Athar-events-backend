# --- Application ---
NODE_ENV=development
PORT=4000
# Public origin of the web app: used for email links and the exact Origin check (CSRF).
APP_ORIGIN=http://localhost:3000
# Comma-separated exact origins allowed to call cookie-authenticated endpoints.
CORS_ORIGINS=http://localhost:3000
# Number of trusted proxies between the client and the API. Next's /api rewrite does NOT add
# X-Forwarded-For, so in production put nginx in front (it appends the client IP) and use 1;
# locally through the Next rewrite use 1 as well. Never expose the API or Next ports publicly.
TRUST_PROXY_HOPS=1

# --- Database (docker-compose.yml: postgres on 5433) ---
DB_HOST=localhost
DB_PORT=5433
DB_USER=athar_events
DB_PASSWORD=athar_events_dev
DB_NAME=athar_events
DB_SSL=false

# --- Redis (rate limits; docker-compose.yml: 6380) ---
REDIS_URL=redis://localhost:6380

# --- Secrets: each at least 32 random bytes, e.g. `openssl rand -base64 48`. Never commit real values. ---
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
TOKEN_PEPPER=replace-with-a-different-long-random-secret-32-bytes
OTP_SECRET=replace-with-a-third-long-random-secret-at-least-32b
JWT_ISSUER=athar-events
JWT_AUDIENCE=athar-events-web
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
# Secure cookies require HTTPS; keep true outside local http development.
COOKIE_SECURE=false

# --- SMTP (placeholders; the real values are provided by the owner) ---
# Locally, Mailpit from docker-compose.yml captures mail: host localhost, port 1025, no auth.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME=أثر للمناسبات

# --- Moyasar (test keys only here: an sk_live_ key is refused outside production) ---
# Empty secret key: checkout answers 503 and nothing calls Moyasar.
MOYASAR_SECRET_KEY=
MOYASAR_PUBLISHABLE_KEY=
# Your own random string (16+ chars); enter the same value when registering the webhook
# https://<domain>/api/payments/moyasar/webhook in the Moyasar dashboard. Empty: webhooks get 401.
MOYASAR_WEBHOOK_SECRET=
MOYASAR_API_BASE_URL=https://api.moyasar.com/v1

# WhatsApp invitation template (ADR-0003). Scheduling is refused until the status is APPROVED at Meta.
WHATSAPP_INVITATION_TEMPLATE=athar_invitation
WHATSAPP_INVITATION_TEMPLATE_STATUS=PENDING
