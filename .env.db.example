# Database administration secrets: copy to /srv/athar-events/backend/.env.db and chmod 600.
# Used only by the data stack (docker-compose.prod.yml) and the migration step of the
# deploy script. Never given to the API containers. No quotes around values.

POSTGRES_SUPERUSER=athar_events_admin
POSTGRES_SUPERUSER_PASSWORD=

# Owns the schema; runs migrations once per release.
MIGRATION_DB_USER=athar_events_migrator
MIGRATION_DB_PASSWORD=
