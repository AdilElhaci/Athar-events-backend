# Production runtime configuration: copy to /srv/athar-events/backend/.env and chmod 600.
# Read by the API container (env_file) and by `docker run --env-file`, which does NOT strip
# quotes: write values without quotes. Generate each secret with `openssl rand -base64 48`.

# --- Public site (also baked into the web build) ---
PUBLIC_URL=https://atharevents.sa
NEXT_PUBLIC_CONTACT_WHATSAPP=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_HOURS=
NEXT_PUBLIC_SIGN_IN_ENABLED=true
# Server-side packages fetch from the web container. Leave empty until GET /packages exists,
# then set to http://api:4000/api
WEB_API_URL=

# --- API ---
NODE_ENV=production
APP_ORIGIN=https://atharevents.sa
CORS_ORIGINS=https://atharevents.sa
# nginx is the one proxy in front of the API (it routes /api directly).
TRUST_PROXY_HOPS=1
COOKIE_SECURE=true

# --- Database: application role (rows only). The migration role lives in .env.db ---
DB_HOST=athar-events-db
DB_PORT=5432
DB_NAME=athar_events
DB_USER=athar_events_app
DB_PASSWORD=
DB_SSL=false

# --- Redis ---
REDIS_PASSWORD=
# Same password as above, inside the URL.
REDIS_URL=redis://:REPLACE_WITH_REDIS_PASSWORD@athar-events-redis:6379

# --- Secrets (each different, at least 32 bytes) ---
JWT_SECRET=
TOKEN_PEPPER=
OTP_SECRET=
JWT_ISSUER=athar-events
JWT_AUDIENCE=athar-events-web
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30

# --- SMTP (transactional provider, OQ-20) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=info@atharevents.sa
# Team inbox for the website contact form (defaults to MAIL_FROM when empty).
CONTACT_INBOX=info@atharevents.sa
MAIL_FROM_NAME=أثر للمناسبات
